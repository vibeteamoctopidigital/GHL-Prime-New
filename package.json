{
  "name": "ghlprime-backend",
  "version": "1.0.0",
  "description": "GHL Prime backend API — Node.js, Express, TypeScript, JWT, PostgreSQL, Prisma",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "vercel-build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "sitemap:refresh": "tsx scripts/refresh-sitemap.ts",
    "blog-ai:cron": "tsx scripts/runBlogAi.ts",
    "routes": "tsx scripts/list-routes.ts",
    "test:api": "tsx scripts/list-routes.ts --json && node scripts/test-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "node-pty": "^1.1.0",
    "nodemailer": "^6.9.16",
    "openai": "^7.10.0",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
