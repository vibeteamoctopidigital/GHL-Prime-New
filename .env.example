NODE_ENV=development
PORT=4000

# Supabase — database + image storage
# URL and secret key: Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# JWT — required. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated frontend origins. Include the scheme, no trailing slash.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

SITE_URL=https://ghlprime.com
# Guards POST /sitemap/refresh. Generate with: openssl rand -hex 32
SITEMAP_REFRESH_TOKEN=
SITEMAP_OUTPUT_DIR=../ghlprime-example/public

CONTACT_WEBHOOK_URL=
SURVEY_WEBHOOK_URL=
CONTACT_MIN_FILL_MS=2500

# Cloudinary — image uploads. Dashboard → Settings → API Keys.
# The key must have the "create" permission or uploads return 502.
# Optional: without these the API runs and only /uploads/* returns 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ghlprime
# Unsigned upload preset name (Cloudinary → Settings → Upload presets).
# Required when the account denies signed uploads; leave empty to use signed.
CLOUDINARY_UPLOAD_PRESET=
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FILES=10

SEED_ADMIN_EMAIL=admin@ghlprime.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=GHL Prime Admin

# Auto Blog (AI blog publishing) — AES-256-GCM key encrypting the
# Anthropic/OpenAI API keys admins add on the Auto Blog settings page.
# Must decode to exactly 32 raw bytes, hex-encoded here. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Auto Blog admin alert emails — optional. The app boots and runs fine
# without these; alerts just log a warning and no-op until they're set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GHL Prime Auto Blog <noreply@ghlprime.com>"
# Comma-separated list of admin addresses that receive Auto Blog alerts.
ADMIN_ALERT_EMAILS=
