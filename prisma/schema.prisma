// =============================================================================
// Blog Writer (AI blog publishing, CLI-subscription based)
// =============================================================================
//
// The BlogAiSettings/BlogAiAccount/BlogAiRun/BlogAiDraft models above are the
// retired Auto Blog feature. Their tables are left exactly as they are on
// purpose; dropping them is a separate, explicitly-confirmed step.
//
// Nothing in the HTTP API writes anything but a `pending` BlogWriteRequest or
// the queue/schedule rows an editor edits. The watcher (scripts/blog-watch.ts)
// is the only process that claims a request, spawns `claude`, and moves a
// request through running -> waiting/done/failed. The importer
// (scripts/blog-import.ts, run by the spawned session) is the only thing that
// marks a topic `done`.

/**
 * One queued blog topic, as the dashboard holds it.
 * Records what to write and how, never the writing itself. A finished post is a
 * BlogPost row; this keeps only the pointer (`blog_slug`) so a topic can be
 * re-queued without dragging an old draft along.
 */
model BlogTopic {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /**
   * The keyword to rank for, an article URL, or a bare domain.
   */
  topic String
  /**
   * 'keyword' | 'link' | 'site' — derived from `topic` by classifyTopic(), stored so the list can badge without re-parsing.
   */
  kind  String @default("keyword")
  /**
   * Steering for the writer: angle, stance, what to emphasise.
   */
  notes String @default("")

  /**
   * Per-topic overrides. Null and "" mean "use the queue default" — a 0 here
   * would be indistinguishable from "no images, deliberately".
   */
  image_count Int?
  words       Int?
  cta_variant String @default("")

  /**
   * 'queued' | 'writing' | 'done' | 'skipped'.
   */
  status String @default("queued")
  /**
   * Manual position within the queue. Lower runs first. Sparse (steps of 10).
   */
  order  Int    @default(0)

  /**
   * The batch that finished (or, for a scheduled batch, owns) this topic. Empty otherwise.
   */
  batch_id String @default("")

  /**
   * The schedule that put this row in the queue, if one did. The name is kept
   * alongside so a row can be labelled without a lookup and still reads
   * correctly if the schedule is renamed later.
   */
  schedule_id   String? @db.Uuid
  schedule_name String  @default("")

  /**
   * Set by the importer once a post exists, so the row links to its result.
   */
  blog_slug  String    @default("")
  written_at DateTime? @db.Timestamptz(6)

  /**
   * Why a topic was dropped, so the same rejected idea is not re-added three times.
   */
  skip_reason String @default("")

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  schedule       BlogRunSchedule?   @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  write_requests BlogWriteRequest[]
  posts          BlogPost[]

  @@index([status, order])
  @@index([kind])
  @@index([batch_id])
  @@index([schedule_id])
  @@map("blog_topics")
}

/**
 * One press of "write the next post" (or one link of a batch / a schedule's
 * day). The button cannot write anything itself: generation runs in a Claude
 * Code session on the watcher's machine, on a subscription, and a watcher
 * picks this row up.
 * `waiting` is not a kind of failure: a run stopped by the usage limit parks
 * itself here with `retry_after` and resumes by itself. `failed` is kept for
 * what an editor genuinely has to act on.
 */
model BlogWriteRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /**
   * 'pending' | 'running' | 'waiting' | 'done' | 'failed'.
   */
  status String @default("pending")

  /**
   * The topic this request is for, when named. Null means "whatever is next in the queue".
   */
  topic_id String? @db.Uuid

  /**
   * Who pressed it: an email, `batch:<id>`, or `schedule:<name>` for an automatic run.
   */
  requested_by String @default("")

  /**
   * Posts this request is for, when a schedule asked for a number. 0 = the site-wide default.
   */
  posts_per_run Int @default(0)

  started_at  DateTime? @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)

  /**
   * Where the run has got to, written by the watcher from the writer's own
   * tool calls — never from a timer. One of RUN_PHASES in lib/rules.ts.
   */
  phase  String @default("starting")
  detail String @default("")
  /**
   * Each phase reached, in order: [{ phase, detail, at }].
   */
  steps  Json   @default("[]")

  /**
   * Slug of the post that came out, so the row links to its draft.
   */
  blog_slug String @default("")

  /**
   * The topic this run was for, in words — so a failed run still says which title it was on.
   */
  topic_label String @default("")

  /**
   * 'limit' | 'timeout' | 'nothing-to-write' | 'no-post' | 'error'. Null while running and on success.
   */
  failure_kind String?

  /**
   * How many times this request has been tried; drives and caps the automatic backoff.
   */
  attempts    Int       @default(0)
  /**
   * When a `waiting` request becomes claimable again.
   */
  retry_after DateTime? @db.Timestamptz(6)

  /**
   * The chain of single-post runs this belongs to, if any. Empty for a plain press.
   */
  batch_id    String @default("")
  /**
   * How many the batch set out to write, for "12 of 50".
   */
  batch_total Int    @default(0)

  /**
   * What the run cost, as Claude Code reported it in its closing `result`
   * event: { inputTokens, outputTokens, cacheReadTokens, cacheCreationTokens,
   * costUsd, turns, durationMs, models }. Null when the run died before
   * reporting — unknown, never zero.
   */
  usage Json?

  /**
   * Why it failed, in words an editor can act on. The tail of the run's own output.
   */
  error String @default("")

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  topic BlogTopic? @relation(fields: [topic_id], references: [id], onDelete: SetNull)

  @@index([status, retry_after, created_at])
  @@index([batch_id])
  @@map("blog_write_requests")
}

/**
 * One alarm, and everything it runs on.
 * Self-contained: a schedule carries its own keywords (blog_schedule_keywords)
 * and its own sites (`sites`), so two schedules cannot interfere. `mode`
 * decides which list it reads: 'queue' takes the next keywords from its own
 * list, 'sources' scans its own sites for the day's best stories.
 * What it does NOT carry is auto-publish — that is one decision about the
 * site (blog_writer_settings), and two schedules disagreeing about it would
 * make the question unanswerable.
 */
model BlogRunSchedule {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String  @default("New schedule")
  /**
   * Off keeps every setting but stops the alarm acting.
   */
  enabled Boolean @default(false)
  /**
   * 'queue' | 'sources'.
   */
  mode    String  @default("queue")

  /**
   * 24-hour "HH:MM", read in `timezone` (an IANA zone name).
   */
  time     String @default("07:00")
  timezone String @default("Asia/Dhaka")

  /**
   * Posts one session writes — capped at 3 because they share a context.
   */
  posts_per_run Int @default(1)
  /**
   * Posts a day, each its own session. A different measurement — see MAX_PER_DAY in lib/rules.ts.
   */
  posts_per_day Int @default(10)

  /**
   * A Google Sheets content calendar this schedule imports from. Only read when Import is pressed.
   */
  sheet_url String @default("")

  /**
   * Pictures, length and banner for the posts this schedule produces.
   */
  image_count Int    @default(1)
  words       Int    @default(500)
  /**
   * Empty means the site-wide pin, the same fallback a topic uses.
   */
  cta_variant String @default("")

  /**
   * This schedule's own publications (mode 'sources'):
   * [{ url, notes, enabled, lastUsedAt, lastScan: { at, found, shown, picked, via, error } | null }].
   * Small enough (<= 100) to live on the row.
   */
  sites Json @default("[]")

  /**
   * The last date, in this schedule's own timezone, that its alarm was acted on — so it fires once a day.
   */
  last_run_day String @default("")

  order Int @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  keywords BlogScheduleKeyword[]
  topics   BlogTopic[]

  @@index([enabled, order])
  @@map("blog_run_schedules")
}

/**
 * A keyword a schedule will write, waiting its turn.
 * Its own table rather than a JSON list on the schedule: a transferred backlog
 * is hundreds of rows, paged from the dashboard and consumed from the front
 * every morning, and Postgres pages and counts a table far better than it
 * slices a JSON array. `position` is sparse (steps of 10); the front of the
 * list is the lowest value.
 * The three overrides follow the queue's convention: null and "" mean
 * "whatever the schedule says", so a row moved in from the queue arrives
 * intact and one that never overrode anything picks up the schedule's own.
 */
model BlogScheduleKeyword {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id String @db.Uuid
  position    Int
  topic       String
  notes       String @default("")
  image_count Int?
  words       Int?
  cta_variant String @default("")

  created_at DateTime @default(now()) @db.Timestamptz(6)

  schedule BlogRunSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, position])
  @@map("blog_schedule_keywords")
}

/**
 * A deleted schedule, kept for a week in case it should not have been.
 * Deleting a schedule hands its keywords back to the queue, so nothing written
 * is lost; what would go for good is the schedule itself — its name, hour,
 * timezone, daily count, sheet link. The whole row is photographed here on the
 * way out. The watcher prunes rows older than seven days at startup (Postgres
 * has no TTL index).
 */
model BlogDeletedSchedule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id   String   @db.Uuid
  /**
   * The schedule exactly as it was, keywords included. Deliberately untyped.
   */
  snapshot      Json
  keyword_count Int      @default(0)
  /**
   * True when it had nothing left to write — it had finished its job.
   */
  completed     Boolean  @default(false)
  deleted_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([deleted_at])
  @@map("blog_deleted_schedules")
}

/**
 * One row per dashboard-wide preference, as key/value.
 * A key/value table rather than a single settings row: a new preference is a
 * new row, not a migration, and two people saving two different preferences
 * at once cannot overwrite each other. Keys live in SETTING_KEYS in
 * lib/rules.ts (queue defaults, auto-publish, the active batch, the summary's
 * cleared-at, the writer heartbeat, the pinned CTA banner).
 */
model BlogWriterSetting {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("blog_writer_settings")
}
